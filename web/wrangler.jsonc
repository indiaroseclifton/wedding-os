{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vowfolk-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEMO_AUTH": "1",
    "DATA_BACKEND": "file"
  }
}
